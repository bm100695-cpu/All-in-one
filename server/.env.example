# Use SANDBOX for Cashfree test credentials and PRODUCTION for live credentials.
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_APP_ID=replace_with_cashfree_app_id
CASHFREE_SECRET_KEY=replace_with_cashfree_secret_key
CASHFREE_API_VERSION=2022-09-01

# Public HTTPS URLs used for the browser return and signed webhook flows.
PUBLIC_APP_URL=https://your-lms.example
PUBLIC_API_URL=https://your-api.example
# Optional if the webhook is configured explicitly rather than derived from PUBLIC_API_URL.
# CASHFREE_WEBHOOK_URL=https://your-api.example/api/monetization/webhook/cashfree

# List only methods actually enabled by the Cashfree merchant account.
# Leave unset to expose only the generic official hosted-checkout entry.
# CASHFREE_ENABLED_PAYMENT_METHODS=GOOGLE_PAY,PHONEPE,PAYTM,OTHER_UPI,UPI_QR,CARD,NETBANKING
